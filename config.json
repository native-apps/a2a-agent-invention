{
  "id": "a2a-agent",
  "name": "A2A Agent",
  "description": "Deploy an AI Agent to your website via Hero Search. Visitors type in any search field, hit ENTER, and the fullscreen A2A Chat UI opens with their query. Uses the A2A Protocol endpoint on Cloudflare Workers, isolated chat database (local Postgres + Supabase sync), and a CRM view for monitoring conversations. The agent answers using your project's knowledge base via MCP tools.",
  "type": "a2a-agent",
  "version": "1.2.197",
  "enabled": false,
  "installedAt": "2026-05-31T17:00:00.000Z",
  "updatedAt": "2026-08-26T18:00:00.000Z",
  "projectIds": [],
  "settings": {},
  "database": {
    "provider": "embedded-pg",
    "collection": "a2a_agent_chat",
    "schemaDir": "backend/schema/"
  },
  "permissions": {
    "dataAccess": {
      "memories": "read",
      "codeIndex": "read",
      "gitHistory": "read",
      "reflections": "read"
    }
  },
  "actions": {
    "deploy": {
      "type": "cloudflare-deploy",
      "sourceDir": "backend/",
      "secrets": {
        "VOYAGE_API_KEY": "embeddingApiKey",
        "SUPABASE_URL": "supabaseUrl",
        "SUPABASE_SERVICE_KEY": "supabaseServiceKey",
        "MB_SUPABASE_URL": "mbSupabaseUrl",
        "MB_SUPABASE_SERVICE_KEY": "mbSupabaseServiceKey",
        "MB_PROJECT_ID": "mbProjectId",
        "MOTHER_BRAIN_GATEWAY_TOKEN": "gatewayToken",
        "GATEWAY_BASE_URL": "gatewayBaseUrl",
        "AGENT_NAME": "agentName",
        "AGENT_DESCRIPTION": "agentDescription",
        "AGENT_URL": "agentUrl",
        "AGENT_SKILLS_JSON": "agentSkillsJson",
        "AGENT_PROVIDER": "agentProvider",
        "MOTHER_BRAIN_USER_TOKEN": "accessToken",
        "MCP_BASE_URL": "mcpBaseUrl",
        "MCP_API_KEY": "mcpApiKey",
        "WEBSITE_URL": "websiteUrl",
        "ENCORE_API_URL": "encoreApiUrl",
        "ENCORE_API_KEY": "encoreApiKey",
        "JWT_SECRET": "jwtSecret",
        "TELEGRAM_BOT_TOKEN": "telegramBotToken",
        "MCP_CLOUD_URL": "mcpCloudUrl",
        "FORCE_CLOUD_MCP": "forceCloudMcp",
        "AGENT_GOALS_JSON": "neighborGoalsJson",
        "AGENT_NEIGHBOR_TARGETS_JSON": "neighborTargetsJson",
        "HEARTBEAT_ENABLED": "heartbeatEnabled",
        "HEARTBEAT_SCHEDULE_JSON": "heartbeatScheduleJson",
        "AGENT_NEIGHBOR_AUTONOMY": "neighborAutonomy",
        "AGENT_NEIGHBOR_SOPS_JSON": "neighborSopsJson",
        "AGENT_NEIGHBOR_INSTRUCTIONS_JSON": "neighborInstructionsJson"
      }
    },
    "provision-db": {
      "type": "supabase-provision",
      "schemaDir": "backend/schema/"
    },
    "start-db": {
      "type": "embedded-pg-start",
      "collection": "a2a_agent_chat",
      "schemaDir": "backend/schema/"
    },
    "sync-db": {
      "type": "embedded-pg-sync",
      "collection": "a2a_agent_chat",
      "tables": [
        "agents",
        "tasks",
        "artifacts",
        "task_messages"
      ],
      "direction": "both"
    },
    "stop-db": {
      "type": "embedded-pg-stop",
      "collection": "a2a_agent_chat"
    },
    "health-check": {
      "type": "endpoint-check",
      "urlSetting": "agentUrl"
    },
    "test-connection": {
      "type": "supabase-test"
    },
    "status": {
      "type": "status",
      "collection": "a2a_agent_chat",
      "countTables": {
        "conversations": "tasks",
        "messages": "task_messages"
      }
    }
  },
  "tools": [
    "a2a-chat-query",
    "a2a-chat-send",
    "a2a-visitor-list",
    "a2a-entity-list",
    "a2a-entity-update"
  ],
  "routes": [
    "/api/inventions/a2a-agent/*"
  ],
  "icon": "MessageSquare",
  "author": "Native Apps Dev",
  "homepage": "https://motherbrain.app",
  "screenshots": [
    "https://raw.githubusercontent.com/native-apps/a2a-agent-invention/main/docs/images/a2a-agent-screenshot.png"
  ],
  "components": {
    "Wizard": "settings/A2aWizard2.tsx",
    "Conversations": "crm/A2aCrmView.tsx",
    "Entities": "crm/EntitiesView.tsx",
    "Neighbors": "crm/NeighborsView.tsx",
    "preview": "settings/A2aChatPreview.tsx",
    "readme": "settings/A2aReadme.tsx"
  }
}