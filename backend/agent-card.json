{
  "name": "AI Assistant",
  "description": "An AI assistant deployed via the A2A Agent. Provides product information, technical support, and general assistance from the organization's knowledge base.",
  "version": "1.0.0",
  "documentationUrl": "",
  "iconUrl": "",
  "provider": {
    "organization": "",
    "url": ""
  },
  "supportedInterfaces": [
    {
      "url": "",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0"
    }
  ],
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": false
  },
  "securitySchemes": {
    "bearer": {
      "httpAuthSecurityScheme": {
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "defaultInputModes": [
    "text/plain",
    "application/json"
  ],
  "defaultOutputModes": [
    "text/plain",
    "application/json"
  ],
  "skills": [
    {
      "id": "product-info",
      "name": "Product Information",
      "description": "Answer questions about the organization's product, features, pricing, and capabilities",
      "tags": [
        "product",
        "features",
        "pricing",
        "info"
      ],
      "examples": [
        "What features do you have?",
        "How much does it cost?"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    },
    {
      "id": "technical-support",
      "name": "Technical Support",
      "description": "Help with installation, configuration, deployment, and troubleshooting",
      "tags": [
        "support",
        "technical"
      ],
      "examples": [
        "How do I install?",
        "My deployment failed"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    },
    {
      "id": "developer-onboarding",
      "name": "Developer Onboarding",
      "description": "Guide developers through getting started with the product and its APIs",
      "tags": [
        "api",
        "developer",
        "onboarding"
      ],
      "examples": [
        "How do I get started?",
        "Show me an API example"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    },
    {
      "id": "general-support",
      "name": "General Support",
      "description": "Answer general questions and provide helpful guidance",
      "tags": [
        "general",
        "support"
      ],
      "examples": [
        "How can you help me?",
        "What can you do?"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    }
  ]
}